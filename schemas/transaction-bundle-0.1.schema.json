{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/schemas/transaction-bundle-0.1.schema.json",
  "title": "ETP lifecycle bundle",
  "description": "An ETP lifecycle prefix without test metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["commitment", "proposal", "decision"],
  "properties": {
    "commitment": {
      "$ref": "https://billmedj.github.io/etp/schemas/task-commitment-0.1.schema.json"
    },
    "proposal": {
      "$ref": "https://billmedj.github.io/etp/schemas/effect-proposal-0.1.schema.json"
    },
    "decision": {
      "$ref": "https://billmedj.github.io/etp/schemas/authorization-decision-0.1.schema.json"
    },
    "grant": {
      "oneOf": [
        { "$ref": "https://billmedj.github.io/etp/schemas/execution-grant-0.1.schema.json" },
        { "type": "null" }
      ]
    },
    "receipt": {
      "oneOf": [
        { "$ref": "https://billmedj.github.io/etp/schemas/effect-receipt-0.1.schema.json" },
        { "type": "null" }
      ]
    },
    "reconciliations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "https://billmedj.github.io/etp/schemas/reconciliation-record-0.1.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["receipt"],
        "properties": { "receipt": { "type": "object" } }
      },
      "then": {
        "required": ["grant"],
        "properties": {
          "grant": {
            "$ref": "https://billmedj.github.io/etp/schemas/execution-grant-0.1.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "required": ["reconciliations"],
        "properties": { "reconciliations": { "type": "array", "minItems": 1 } }
      },
      "then": {
        "required": ["receipt"],
        "properties": {
          "receipt": {
            "$ref": "https://billmedj.github.io/etp/schemas/effect-receipt-0.1.schema.json"
          }
        }
      }
    }
  ]
}
