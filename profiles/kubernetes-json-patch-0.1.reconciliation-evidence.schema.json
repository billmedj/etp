{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/kubernetes-json-patch-0.1.reconciliation-evidence.schema.json",
  "title": "Kubernetes JSON Patch profile 0.1: reconciliation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "attempt_id", "target", "observed_at_ms", "uid", "resource_version", "object_sha256", "attribution", "postconditions"],
  "properties": {
    "profile": {"const": "effect-transaction/kubernetes-json-patch/0.1"},
    "document_type": {"const": "reconciliation_evidence"},
    "version": {"const": 1},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target": {"type": "string", "minLength": 10, "maxLength": 4096},
    "observed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "uid": {"type": "string", "minLength": 8, "maxLength": 128},
    "resource_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "object_sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "attribution": {"$ref": "https://billmedj.github.io/etp/profiles/kubernetes-json-patch-0.1.observation-evidence.schema.json#/$defs/attribution"},
    "postconditions": {"type": "array", "maxItems": 128, "items": {"$ref": "https://billmedj.github.io/etp/profiles/kubernetes-json-patch-0.1.observation-evidence.schema.json#/$defs/observation"}}
  }
}
