{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/kubernetes-json-patch-0.1.observation-evidence.schema.json",
  "title": "Kubernetes JSON Patch profile 0.1: observation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "attempt_id", "target", "observed_at_ms", "transport_outcome", "postconditions"],
  "properties": {
    "profile": {"const": "effect-transaction/kubernetes-json-patch/0.1"},
    "document_type": {"const": "observation_evidence"},
    "version": {"const": 1},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target": {"type": "string", "minLength": 10, "maxLength": 4096},
    "observed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "transport_outcome": {"enum": ["response", "lost", "unverifiable"]},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "uid": {"type": "string", "minLength": 8, "maxLength": 128},
    "resource_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "object_sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "attribution": {"$ref": "#/$defs/attribution"},
    "postconditions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/observation"}}
  },
  "allOf": [
    {"if": {"properties": {"transport_outcome": {"const": "response"}}}, "then": {"required": ["http_status", "uid", "resource_version", "object_sha256"]}},
    {"if": {"properties": {"transport_outcome": {"enum": ["lost", "unverifiable"]}}}, "then": {"not": {"anyOf": [{"required": ["http_status"]}, {"required": ["object_sha256"]}]}}}
  ],
  "$defs": {
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["audit_event_id", "mutation_marker", "none"]},
        "value": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "established", "observed_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "established": {"type": "boolean"},
        "observed_sha256": {"type": ["string", "null"], "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }
    }
  }
}
