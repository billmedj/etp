{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/http-conditional-0.1.observation-evidence.schema.json",
  "title": "HTTP conditional profile 0.1: observation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "attempt_id", "target", "observed_at_ms", "transport_outcome", "postconditions"],
  "properties": {
    "profile": {"const": "effect-transaction/http-conditional/0.1"},
    "document_type": {"const": "observation_evidence"},
    "version": {"const": 1},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target": {"type": "string", "minLength": 9, "maxLength": 4096},
    "observed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "transport_outcome": {"enum": ["response", "lost", "unverifiable"]},
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "response_sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "application_transaction_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "postconditions": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "allOf": [
    {"if": {"properties": {"transport_outcome": {"const": "response"}}}, "then": {"required": ["status", "response_sha256"]}},
    {"if": {"properties": {"transport_outcome": {"enum": ["lost", "unverifiable"]}}}, "then": {"not": {"anyOf": [{"required": ["status"]}, {"required": ["response_sha256"]}]}}}
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "established", "observed_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "established": {"type": "boolean"},
        "observed_sha256": {"type": ["string", "null"], "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }
    }
  }
}
