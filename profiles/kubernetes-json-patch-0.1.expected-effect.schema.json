{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/kubernetes-json-patch-0.1.expected-effect.schema.json",
  "title": "Kubernetes JSON Patch profile 0.1: expected effect",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "postconditions"],
  "properties": {
    "profile": {"const": "effect-transaction/kubernetes-json-patch/0.1"},
    "document_type": {"const": "expected_effect"},
    "version": {"const": 1},
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/postcondition"}
    }
  },
  "$defs": {
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "expected_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "operator": {"enum": ["equals", "absent", "present"]},
        "expected_sha256": {"type": ["string", "null"], "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }
    }
  }
}
