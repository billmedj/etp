{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/http-conditional-0.1.reconciliation-evidence.schema.json",
  "title": "HTTP conditional profile 0.1: reconciliation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "attempt_id", "target", "observed_at_ms", "attribution", "postconditions"],
  "properties": {
    "profile": {"const": "effect-transaction/http-conditional/0.1"},
    "document_type": {"const": "reconciliation_evidence"},
    "version": {"const": 1},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "target": {"type": "string", "minLength": 9, "maxLength": 4096},
    "observed_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["application_idempotency_key", "target_transaction_id", "none"]},
        "value": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "postconditions": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "https://billmedj.github.io/etp/profiles/http-conditional-0.1.observation-evidence.schema.json#/$defs/observation"}
    }
  }
}
