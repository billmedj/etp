{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/http-conditional-0.1.expected-effect.schema.json",
  "title": "HTTP conditional profile 0.1: expected effect",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "allowed_status_classes", "postconditions"],
  "properties": {
    "profile": {"const": "effect-transaction/http-conditional/0.1"},
    "document_type": {"const": "expected_effect"},
    "version": {"const": 1},
    "allowed_status_classes": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": [2, 3, 4]}},
    "response_body_sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/postcondition"}
    }
  },
  "$defs": {
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operator", "expected_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "operator": {"enum": ["equals", "absent", "present"]},
        "expected_sha256": {"type": ["string", "null"], "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }
    }
  }
}
