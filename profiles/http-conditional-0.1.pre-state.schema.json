{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://billmedj.github.io/etp/profiles/http-conditional-0.1.pre-state.schema.json",
  "title": "HTTP conditional profile 0.1: pre-state",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "document_type", "version", "target", "exists"],
  "properties": {
    "profile": {"const": "effect-transaction/http-conditional/0.1"},
    "document_type": {"const": "pre_state"},
    "version": {"const": 1},
    "target": {"type": "string", "minLength": 9, "maxLength": 4096},
    "exists": {"type": "boolean"},
    "strong_etag": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^\"[!#-~]*\"$"}
  },
  "oneOf": [
    {"properties": {"exists": {"const": true}}, "required": ["strong_etag"]},
    {"properties": {"exists": {"const": false}}, "not": {"required": ["strong_etag"]}}
  ]
}
